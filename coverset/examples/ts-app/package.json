{
  "name": "ts-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "5.0.3",
    "coverset-vitest": "file:../../packages/coverset-vitest",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "report": "uv run coverset report .coverset/neutral --repo-root \"$(git rev-parse --show-toplevel)\" --out .coverset/report",
    "refresh-reporter": "npm --prefix ../../packages/coverset-vitest run build && rm -rf node_modules/coverset-vitest && npm install"
  }
}
