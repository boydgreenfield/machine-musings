# coverset settings for deploy/compose.yml (copy to coverset.env, chmod 600; git-ignored).
# Every COVERSET_* key in ../.env.example works here; these are the ones a server needs.
COVERSET_ENV=prod
# https://<COVERSET_DOMAIN>, exactly what GitHub will call
COVERSET_PUBLIC_URL=https://coverset.example.com
# openssl rand -hex 32
COVERSET_ADMIN_TOKEN=
# openssl rand -hex 32, at least 32 characters (sessions survive container rebuilds, and /setup stores
# the GitHub App in the database encrypted under it; rotate with `coverset secrets rekey --old-key ...`,
# docs/security.md)
COVERSET_SECRET_KEY=
# Shards run in Modal Sandboxes; the client authenticates with a Modal token (modal.com/settings/tokens)
COVERSET_EXECUTOR=modal
COVERSET_MODAL_ENVIRONMENT=coverset
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# GitHub: create the App at <public url>/setup (stored in the database; empty owners = the App's
# owner), or set COVERSET_GITHUB_* here yourself (/setup is then read-only; ../.env.example)
COVERSET_ALLOWED_OWNERS=

# --- State ---------------------------------------------------------------------------------------
# The database: compose.yml's Postgres, with POSTGRES_PASSWORD from services.env (or a managed one:
# RDS, Neon, Supabase; docs/postgres.md). coverset creates the database when the server has none.
COVERSET_DATABASE_URL=postgresql://coverset:<POSTGRES_PASSWORD>@postgres:5432/coverset
# Blobs: files under /data by default (keep /data on a persistent disk). With compose.yml's "hosted"
# profile (MinIO on this VM) they live in a bucket and /data is only a cache:
# COVERSET_BLOB_URL=s3://coverset?endpoint_url=http://minio:9000&region=us-east-1
# AWS_ACCESS_KEY_ID=<MINIO_ROOT_USER>
# AWS_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
# Or a managed bucket (S3, R2, Tigris), e.g. COVERSET_BLOB_URL=s3://<bucket>/coverset?region=<region>
