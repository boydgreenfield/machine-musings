# coverset settings for deploy/compose.yml (copy to coverset.env, chmod 600; git-ignored).
# Every COVERSET_* key in ../.env.example works here; these are the ones a server needs.
COVERSET_ENV=prod
# https://<COVERSET_DOMAIN>, exactly what GitHub will call
COVERSET_PUBLIC_URL=https://coverset.example.com
# openssl rand -hex 32
COVERSET_ADMIN_TOKEN=
# openssl rand -hex 32 (sessions survive container rebuilds; rotate to sign everyone out)
COVERSET_SECRET_KEY=
# Shards run in Modal Sandboxes; the client authenticates with a Modal token (modal.com/settings/tokens)
COVERSET_EXECUTOR=modal
COVERSET_MODAL_ENVIRONMENT=coverset
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# GitHub: filled in by the /setup manifest flow (written to /data/.env), or set here
COVERSET_ALLOWED_OWNERS=

# --- State: empty = SQLite + files under /data (keep /data on a persistent disk) -----------------
# Hosted = Postgres + an S3-compatible bucket; then /data is only a cache and the container is
# disposable. With deploy/compose.yml's "hosted" profile (Postgres and MinIO on this VM), using the
# passwords from services.env:
# COVERSET_DATABASE_URL=postgresql+asyncpg://coverset:<POSTGRES_PASSWORD>@postgres:5432/coverset
# COVERSET_BLOB_URL=s3://coverset?endpoint_url=http://minio:9000&region=us-east-1
# AWS_ACCESS_KEY_ID=<MINIO_ROOT_USER>
# AWS_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
# Or managed services (RDS, Neon, S3, R2, Tigris), e.g.
# COVERSET_DATABASE_URL=postgresql+asyncpg://coverset:<password>@<host>:5432/coverset
# COVERSET_BLOB_URL=s3://<bucket>/coverset?region=<bucket region>
# On this VM /data stays a mounted disk either way, so the .env and App key /setup writes there persist.
