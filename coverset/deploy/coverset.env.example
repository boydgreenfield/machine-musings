# coverset settings for deploy/compose.yml (copy to coverset.env, chmod 600; git-ignored).
# Every COVERSET_* key in ../.env.example works here; these are the ones a server needs.
COVERSET_ENV=prod
# https://<COVERSET_DOMAIN>, exactly what GitHub will call
COVERSET_PUBLIC_URL=https://coverset.example.com
# openssl rand -hex 32
COVERSET_ADMIN_TOKEN=
# openssl rand -hex 32 (sessions survive container rebuilds; rotate to sign everyone out)
COVERSET_SECRET_KEY=
# Shards run in Modal Sandboxes; the client authenticates with a Modal token (modal.com/settings/tokens)
COVERSET_EXECUTOR=modal
COVERSET_MODAL_ENVIRONMENT=coverset
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# GitHub: filled in by the /setup manifest flow (written to /data/.env), or set here
COVERSET_ALLOWED_OWNERS=
