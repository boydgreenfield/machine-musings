# The state services of deploy/compose.yml's "hosted" profile (copy to services.env, chmod 600;
# git-ignored). Only the postgres, minio and minio-init containers read this file; coverset reads
# the same values from coverset.env as URLs and credentials (see coverset.env.example).
# openssl rand -hex 24 for each secret.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=coverset
MINIO_ROOT_PASSWORD=
