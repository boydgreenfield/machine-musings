# coverset against the development services (deploy/dev-compose.yml: Postgres 17 + MinIO), the
# same state model as a hosted deployment. DEVELOPMENT ONLY: these are the compose file's well-known
# throwaway credentials, valid on 127.0.0.1 only.
#
#   make services                       # or: docker compose -f deploy/dev-compose.yml up -d --wait
#   unset AWS_SESSION_TOKEN AWS_SECURITY_TOKEN AWS_PROFILE   # an SSO session token breaks the MinIO keys
#   set -a; . ./.env.hosted-dev.example; set +a; uv run coverset dev
#
# `make dev-hosted` (`coverset dev --hosted`) sets exactly these values itself, and starts the
# services when they are down. To make them your default instead, copy the lines into .env.
# Ports moved with COVERSET_DEV_PG_PORT / COVERSET_DEV_S3_PORT must be changed here too.

# Postgres: the compose file's user, password and database, on 55432 (clear of a local Postgres on 5432)
COVERSET_DATABASE_URL=postgresql+asyncpg://coverset:coverset@127.0.0.1:55432/coverset
# MinIO: the bucket minio-init creates; the region is any value MinIO accepts (quoted: & and ? are
# shell syntax, and .env parsing strips the quotes)
COVERSET_BLOB_URL='s3://coverset?endpoint_url=http://127.0.0.1:9000&region=us-east-1'
# MinIO's root user as S3 credentials (console: http://127.0.0.1:9001, same user and password)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Kept apart from the local demo in data/. Not only a cache: next to cache/ it holds the demo's git
# repository, whose path the database records, so it belongs to this database: `make services-reset`
# deletes both. Drop just the cache with `rm -rf data/hosted-dev/cache`.
COVERSET_DATA_DIR=data/hosted-dev

# The test suite against the same services (make test-pg runs the suite with these set):
# COVERSET_TEST_DATABASE_URL=postgresql+asyncpg://coverset:coverset@127.0.0.1:55432/postgres
# COVERSET_TEST_BLOB_URL='s3://coverset?endpoint_url=http://127.0.0.1:9000&region=us-east-1'
