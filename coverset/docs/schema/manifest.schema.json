{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coverset.dev/schema/neutral/v1/manifest.schema.json",
  "title": "manifest.json: what the bundle is and who wrote it",
  "type": "object",
  "required": [
    "format",
    "version",
    "language",
    "producer"
  ],
  "properties": {
    "format": {
      "const": "coverset-neutral"
    },
    "version": {
      "const": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_+-]{0,31}$"
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "shard": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "meta": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
