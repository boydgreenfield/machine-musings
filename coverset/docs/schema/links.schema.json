{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coverset.dev/schema/neutral/v1/links.schema.json",
  "title": "links.jsonl: a test checks an invariant",
  "type": "object",
  "required": [
    "test",
    "invariant"
  ],
  "properties": {
    "test": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "invariant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "additionalProperties": false
}
