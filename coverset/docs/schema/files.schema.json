{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coverset.dev/schema/neutral/v1/files.schema.json",
  "title": "files.jsonl: static facts of one measured source file",
  "type": "object",
  "required": [
    "path",
    "statements"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "n_lines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "additionalProperties": false
}
