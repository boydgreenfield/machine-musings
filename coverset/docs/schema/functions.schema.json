    "body_hash": {
      "type": "string",
      "maxLength": 128
    },
    "sig_hash": {
      "type": "string",
      "maxLength": 128
    },
    "params": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 1024
    },
    "kind": {
      "enum": [
        "function",
        "method",
        "class",
        "module"
      ]
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/descriptor"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
