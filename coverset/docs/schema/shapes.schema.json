{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coverset.dev/schema/neutral/v1/shapes.schema.json",
  "title": "shapes.jsonl: an observation row or a sampling row of the shape tracer",
  "anyOf": [
    {
      "$ref": "#/$defs/obs"
    },
    {
      "$ref": "#/$defs/sampling"
    }
  ],
  "$defs": {
    "obs": {
      "type": "object",
      "required": [
        "kind",
        "func",
        "param",
        "shape",
        "caller",
        "samples",
        "tests"
      ],
      "properties": {
        "kind": {
          "const": "obs"
        },
        "func": {
          "description": "[path, qualname, first line of the declaration]",
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "param": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "shape": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "caller": {
          "anyOf": [
            {
              "description": "[path, qualname, first line of the declaration]",
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              ],
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "object",
              "required": [
                "test"
              ],
              "properties": {
                "test": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "example": {
          "type": [
            "string",
            "null"
          ]
        },
        "example_test": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": [
        "kind",
        "func",
        "calls",
        "tests"
      ],
      "properties": {
        "kind": {
          "const": "sampling"
        },
        "func": {
          "description": "[path, qualname, first line of the declaration]",
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "cap": {
          "enum": [
            "sample",
            "full",
            null
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
