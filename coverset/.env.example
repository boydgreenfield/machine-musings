# coverset configuration. Copy to .env (git-ignored) and fill in what you need; every key is optional.
# Values shown are the defaults unless marked "example". Lists are comma-separated.

# --- Server -------------------------------------------------------------------------------------
# dev | test | prod
COVERSET_ENV=dev
# host:port to listen on; a non-loopback bind refuses to start without COVERSET_ADMIN_TOKEN
COVERSET_BIND=127.0.0.1:8000
# External http(s) base URL used in links, check runs and as the OIDC audience (empty = http://<bind>).
# Without an admin token, only requests whose Host is a loopback name, the bind host or this URL's host
# are answered (DNS-rebinding guard), so set it when a tunnel forwards its own Host header.
COVERSET_PUBLIC_URL=
# Bearer token / login secret for the UI and API, at least 32 characters (example: openssl rand -hex 32)
COVERSET_ADMIN_TOKEN=
# Where the database, mirrors, facts and run scratch live
COVERSET_DATA_DIR=data
# SQLAlchemy URL (empty = sqlite+aiosqlite:///<data_dir>/coverset.db)
COVERSET_DATABASE_URL=

# --- GitHub (App mode or token mode; leave empty to use the fake forge only) ---------------------
# Webhook HMAC secret, at least 16 characters; webhooks are refused (503) while it is empty
COVERSET_GITHUB_WEBHOOK_SECRET=
# GitHub App numeric id (example: 123456)
COVERSET_GITHUB_APP_ID=
# GitHub App client id (example: Iv23liExample)
COVERSET_GITHUB_APP_CLIENT_ID=
# GitHub App client secret
COVERSET_GITHUB_APP_CLIENT_SECRET=
# Path to the GitHub App private key (PEM)
COVERSET_GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
# Token mode: a fine-grained PAT for commit statuses and comments only
COVERSET_GITHUB_TOKEN=
# Only these owners' repositories are accepted; required when COVERSET_GITHUB_APP_ID is set (example: my-org,my-user)
COVERSET_ALLOWED_OWNERS=
# Only these repositories are accepted, owner/name (example: my-org/app)
COVERSET_ALLOWED_REPOS=
# What to do with PRs from forks or untrusted authors: approve | run_blocked_network | skip
COVERSET_UNTRUSTED_PR_POLICY=approve
# Run draft PRs too
COVERSET_RUN_DRAFTS=false

# --- AI review (advisory) -----------------------------------------------------------------------
# off | fake | anthropic
COVERSET_AI=fake
# Required only when COVERSET_AI=anthropic (example: sk-ant-...)
ANTHROPIC_API_KEY=
# Also review untrusted PRs (their code is prompt input)
COVERSET_AI_REVIEW_UNTRUSTED=false
# Maximum characters of source and facts sent per review bundle
COVERSET_AI_MAX_BUNDLE_CHARS=120000
# Paths never sent to the model (example: secrets/**,*.env)
COVERSET_AI_EXCLUDE_GLOBS=

# --- Execution ----------------------------------------------------------------------------------
# local | modal
COVERSET_EXECUTOR=local
# Parallel shard processes for the local executor (default min(8, CPU count); example: 4)
COVERSET_LOCAL_MAX_WORKERS=
# Allow webhook-triggered runs on the local executor (trusted PRs only)
COVERSET_LOCAL_ALLOW_WEBHOOK_RUNS=false
# Modal environment that holds coverset's sandboxes
COVERSET_MODAL_ENVIRONMENT=coverset
# CPU cores per shard sandbox
COVERSET_SHARD_CPU_LIMIT=2.0
# Memory per shard sandbox, MiB
COVERSET_SHARD_MEMORY_MIB=2048
# Hard ceiling on one run's wall time, seconds
COVERSET_RUN_TIMEOUT_S=1800
# Idle lifetime of a pooled sandbox, seconds
COVERSET_POOL_TTL_S=600
# Warm sandboxes kept per trusted snapshot
COVERSET_POOL_SIZE=4
# Most shards one run may use
COVERSET_MAX_SHARDS=32
# Most live sandboxes across all runs
COVERSET_MAX_SANDBOXES=48
# Most runs executing at once
COVERSET_MAX_CONCURRENT_RUNS=4
# Test retries allowed per run (flaky detection)
COVERSET_RETRY_BUDGET_PER_RUN=5
# Cancel a PR's running run when a newer head arrives
COVERSET_CANCEL_SUPERSEDED=true
# Estimated Modal spend per day before new Modal runs get a neutral "budget exhausted" verdict
COVERSET_MODAL_DAILY_BUDGET_USD=5.00
# Kill switch: store webhooks but start no runs
COVERSET_PAUSED=false
# Sandbox egress: blocked | allowlist | open
COVERSET_SANDBOX_NETWORK=blocked
# Domains reachable when COVERSET_SANDBOX_NETWORK=allowlist (example: pypi.org,files.pythonhosted.org)
COVERSET_SANDBOX_DOMAIN_ALLOWLIST=
# Re-queue runs left queued/running by a previous process at startup (otherwise they are abandoned)
COVERSET_REQUEUE_ON_BOOT=false

# --- Limits -------------------------------------------------------------------------------------
# Largest accepted worker bundle, bytes (200 MiB)
COVERSET_MAX_BUNDLE_BYTES=209715200
# Largest captured stdout/stderr per exec, bytes (50 MiB)
COVERSET_MAX_STDOUT_BYTES=52428800

# --- Public verdict API (coverset-ci wait) ------------------------------------------------------
# Expected aud claim of GitHub Actions OIDC tokens (empty = COVERSET_PUBLIC_URL; never github.com)
COVERSET_OIDC_AUDIENCE=
# Requests per minute per client to GET /v1/verdict
COVERSET_PUBLIC_VERDICT_RPM=60

# --- Retention ----------------------------------------------------------------------------------
# Days to keep runs and their results
COVERSET_RETENTION_RUNS_DAYS=30
# Days to keep webhook delivery payloads (the dedupe row stays)
COVERSET_RETENTION_DELIVERIES_DAYS=14
# Days to keep run event streams
COVERSET_RETENTION_EVENTS_DAYS=7

# --- Testing and screenshots --------------------------------------------------------------------
# Pin "now" for deterministic pages (example: 2026-10-10T12:00:00Z)
COVERSET_FAKE_NOW=
# Skip migrations at startup (tests that build their own schema)
COVERSET_SKIP_MIGRATIONS=false
