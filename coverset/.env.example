# coverset configuration. Copy to .env (git-ignored) and fill in what you need; every key is optional.
# .env holds secrets: keep it private to your user (chmod 600 .env). coverset makes COVERSET_DATA_DIR
# and its mirrors/, facts/ and runs/ directories mode 0700 and the SQLite database 0600 at startup.
# Values shown are the defaults unless marked "example". Lists are comma-separated.

# --- Server -------------------------------------------------------------------------------------
# dev | test | prod
COVERSET_ENV=dev
# host:port to listen on; a non-loopback bind refuses to start without COVERSET_ADMIN_TOKEN
COVERSET_BIND=127.0.0.1:8000
# External http(s) base URL used in links, check runs and as the OIDC audience (empty = http://<bind>).
# Without an admin token, only requests whose Host is a loopback name, the bind host or this URL's host
# are answered (DNS-rebinding guard), so set it when a tunnel forwards its own Host header.
# A public_url outside loopback/.localhost/.test requires COVERSET_ADMIN_TOKEN (set it first)
COVERSET_PUBLIC_URL=
# Bearer token / login secret for the UI and API, at least 32 characters (example: openssl rand -hex 32)
COVERSET_ADMIN_TOKEN=
# GitHub logins that are instance admins once signed in with GitHub (example: octocat,hubot)
COVERSET_ADMINS=
# Lifetime of a browser login session, days
COVERSET_SESSION_DAYS=30
# Honour X-Forwarded-For / X-Forwarded-Proto from the immediate upstream (Caddy, an ALB, Fly, which
# uses Fly-Client-IP): the last value of each, never X-Forwarded-Host. Only behind such a proxy; not
# on Modal, which sets the client address itself (docs/deploy.md)
COVERSET_TRUST_PROXY=false
# Cookie signing key, at least 32 characters (example: openssl rand -hex 32); combined with the admin
# token, so rotating either signs everyone out. Empty = derived from the admin token, else a key file
# under the data dir. Set it on servers so sessions survive a rebuilt container
COVERSET_SECRET_KEY=
# Accept bundles uploaded from your own CI at POST /v1/bundles (coverset-ci upload)
COVERSET_UPLOADS_ENABLED=true
# Largest accepted uploaded bundle, bytes (200 MiB)
COVERSET_MAX_UPLOAD_BYTES=209715200
# Where the database, mirrors, facts and run scratch live (made private to your user: mode 0700)
COVERSET_DATA_DIR=data
# SQLAlchemy URL: empty = SQLite at <data_dir>/coverset.db (laptops, demos); hosted = Postgres
# (example: postgresql+asyncpg://coverset:secret@db.example.com:5432/coverset; a plain postgresql:// URL is accepted)
COVERSET_DATABASE_URL=
# Facts, uploaded bundles and uploaded sources: empty = files under <data_dir>; hosted = any S3-compatible bucket
# (example: s3://coverset-prod/coverset  or, for MinIO/R2/Tigris, s3://bucket/prefix?endpoint_url=http://localhost:9000&region=us-east-1;
# credentials from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, AWS_PROFILE or the instance role)
COVERSET_BLOB_URL=
# Local cache of object-store files and git mirrors (safe to delete; empty = <data_dir>/cache)
COVERSET_CACHE_DIR=
# Hosted = Postgres + a bucket: nothing under COVERSET_DATA_DIR must survive a restart (it is a cache),
# so the app runs on any stateless container platform. Locally: `make dev-hosted` (or `coverset dev
# --hosted`) runs against Postgres + MinIO from deploy/dev-compose.yml; .env.hosted-dev.example has the
# values. `coverset deploy check` prints the database, object store, cache and state rows. docs/deploy.md
# `coverset serve` migrates the database before serving (a container start). Replicas may all keep it
# on: on Postgres an advisory lock runs their migrations one after the other. Set false to migrate
# once per deploy in a release step instead (docs/deploy.md, "Migrations on deploy")
COVERSET_MIGRATE_ON_START=true

# --- GitHub (App mode or token mode; leave empty to use the fake forge only) ---------------------
# Webhook HMAC secret, at least 16 characters; webhooks are refused (503) while it is empty
COVERSET_GITHUB_WEBHOOK_SECRET=
# GitHub App numeric id (example: 123456)
COVERSET_GITHUB_APP_ID=
# GitHub App client id (example: Iv23liExample)
COVERSET_GITHUB_APP_CLIENT_ID=
# GitHub App client secret
COVERSET_GITHUB_APP_CLIENT_SECRET=
# Path to the GitHub App private key (PEM)
COVERSET_GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
# Token mode: a fine-grained PAT for commit statuses and comments only (at least 16 characters)
COVERSET_GITHUB_TOKEN=
# Only these owners' repositories are accepted; required when COVERSET_GITHUB_APP_ID is set (example: my-org,my-user)
COVERSET_ALLOWED_OWNERS=
# Only these repositories are accepted, owner/name (example: my-org/app)
COVERSET_ALLOWED_REPOS=
# What to do with PRs from forks or untrusted authors: approve | run_blocked_network | skip
COVERSET_UNTRUSTED_PR_POLICY=approve
# Run draft PRs too
COVERSET_RUN_DRAFTS=false

# --- AI review (advisory) -----------------------------------------------------------------------
# off | fake | anthropic
COVERSET_AI=fake
# Run `coverset invariants scan` automatically after a trusted baseline of the default branch's tip
COVERSET_SCAN_AFTER_BASELINE=true
# Required only when COVERSET_AI=anthropic (example: sk-ant-...)
ANTHROPIC_API_KEY=
# Also review untrusted PRs (their code is prompt input)
COVERSET_AI_REVIEW_UNTRUSTED=false
# Maximum characters of source and facts sent per review bundle
COVERSET_AI_MAX_BUNDLE_CHARS=120000
# Paths never sent to the model (example: secrets/**,*.env)
COVERSET_AI_EXCLUDE_GLOBS=

# --- Execution ----------------------------------------------------------------------------------
# local | modal
# Forge adapter: auto (github when App/token credentials exist, else fake), github, or fake
COVERSET_FORGE=auto
# Untrusted (fork / non-member) PRs: approve (needs the App's approve-run button or POST /runs/<id>/approve),
# run_blocked_network (the default in token mode) or skip
COVERSET_EXECUTOR=local
# Parallel shard processes for the local executor (default min(8, CPU count); example: 4)
COVERSET_LOCAL_MAX_WORKERS=
# Allow webhook-triggered runs on the local executor (trusted PRs only)
COVERSET_LOCAL_ALLOW_WEBHOOK_RUNS=false
# Modal environment that holds coverset's sandboxes (MODAL_ENVIRONMENT is not read for this)
COVERSET_MODAL_ENVIRONMENT=coverset
# CPU cores per shard sandbox (at most 16)
COVERSET_SHARD_CPU_LIMIT=2.0
# Memory per shard sandbox, MiB (at most 65536)
COVERSET_SHARD_MEMORY_MIB=2048
# Hard ceiling on one run's wall time, seconds (at most 7200)
COVERSET_RUN_TIMEOUT_S=1800
# Idle lifetime of a pooled sandbox, seconds (at most 86400; 0 = no idle timeout)
COVERSET_POOL_TTL_S=600
# Warm sandboxes kept per trusted snapshot (at most 32)
COVERSET_POOL_SIZE=4
# Most shards one run may use, `coverset run --shards` included (at most 128)
COVERSET_MAX_SHARDS=32
# Most live sandboxes one coverset process creates (one counter per process; at most 256)
COVERSET_MAX_SANDBOXES=48
# Most runs executing at once
COVERSET_MAX_CONCURRENT_RUNS=4
# Test retries allowed per run (flaky detection)
COVERSET_RETRY_BUDGET_PER_RUN=5
# Cancel a PR's running run when a newer head arrives
COVERSET_CANCEL_SUPERSEDED=true
# Estimated Modal spend per UTC day (runs, pool idle time, snapshots, smoke tests, image builds);
# a Modal run that would pass it gets a neutral "budget exhausted" verdict (at most 1000)
COVERSET_MODAL_DAILY_BUDGET_USD=5.00
# Most one Modal run may cost: its reservation (workers x run timeout at the limit rate, capped
# here) and a live stop with reason "run cost cap $X reached"; must not exceed the daily budget
COVERSET_MAX_RUN_COST_USD=1.00
# Modal env image builds per UTC day (each priced into the daily budget, estimated)
COVERSET_MAX_IMAGE_BUILDS_PER_DAY=20
# Kill switch: store webhooks but start no runs
COVERSET_PAUSED=false
# Sandbox egress: blocked | allowlist | open
COVERSET_SANDBOX_NETWORK=blocked
# Domains reachable when COVERSET_SANDBOX_NETWORK=allowlist (example: pypi.org,files.pythonhosted.org)
COVERSET_SANDBOX_DOMAIN_ALLOWLIST=
# Re-queue runs left queued/running by a previous process at startup (otherwise they are abandoned)
COVERSET_REQUEUE_ON_BOOT=false

# --- Limits -------------------------------------------------------------------------------------
# Largest accepted worker bundle, bytes (200 MiB)
COVERSET_MAX_BUNDLE_BYTES=209715200
# Largest captured stdout/stderr per exec, bytes (50 MiB)
COVERSET_MAX_STDOUT_BYTES=52428800

# --- Public verdict API (coverset-ci wait) ------------------------------------------------------
# Expected aud claim of GitHub Actions OIDC tokens (empty = COVERSET_PUBLIC_URL; never github.com)
COVERSET_OIDC_AUDIENCE=
# Requests per minute per client to GET /v1/verdict
COVERSET_PUBLIC_VERDICT_RPM=60

# --- Retention ----------------------------------------------------------------------------------
# Days to keep runs and their results
COVERSET_RETENTION_RUNS_DAYS=30
# Days to keep webhook delivery payloads (the dedupe row stays)
COVERSET_RETENTION_DELIVERIES_DAYS=14
# Days to keep run event streams
COVERSET_RETENTION_EVENTS_DAYS=7

# --- Caches (docs/data-model.md "Caches"; sizing in docs/benchmarks.md) --------------------------
# Every key is optional: unset, the module reads the same variable from the process environment and
# then uses the default shown. For a 1-2 GB server: RUN_FACTS_MB=128, RUN_FACTS_ENTRIES=4,
# FACTS_CACHE_ENTRIES=8, FACTS_THREADS=2.
# Values set in this file apply to `coverset serve`, `run`, `demo` and `seed` only; the other
# commands (`coverset mcp`, `report`, `facts query`, ...) read these knobs from the process
# environment alone, so export them there (e.g. COVERSET_AGENT_CONTEXTS for `coverset mcp`).
# DuckDB databases the facts layer keeps cached (one per repo/run scope)
COVERSET_FACTS_CACHE_ENTRIES=16
# DuckDB memory_limit of each cached database (a size: 512MB, 1.5GiB)
COVERSET_FACTS_MEMORY_LIMIT=512MB
# DuckDB threads of each cached database (default min(4, CPU count); example: 2)
COVERSET_FACTS_THREADS=
# Memoised run-scoped query results (treemap, gaps, function history)
COVERSET_FACTS_RESULT_ENTRIES=256
# Runs whose indexed facts the web keeps in memory
COVERSET_RUN_FACTS_ENTRIES=8
# Estimated MB those cached runs may hold together (RSS grows by about 1.5 times this)
COVERSET_RUN_FACTS_MB=384
# MB of source text the web keeps (blobs read from the mirrors)
COVERSET_SOURCE_CACHE_MB=64
# Also write the compact per-(test, file) bitset layout test_file_bits at ingest
COVERSET_FACTS_COMPACT=false
# Run contexts the agent API and MCP server keep (each can be several hundred MB for a big run)
COVERSET_AGENT_CONTEXTS=3

# --- Testing and screenshots --------------------------------------------------------------------
# Pin "now" for deterministic pages (example: 2026-10-10T12:00:00Z)
COVERSET_FAKE_NOW=
# Skip migrations at startup (tests that build their own schema)
COVERSET_SKIP_MIGRATIONS=false
# Development only: offer "Sign in as a local user" (any login, admin or member, per-repository
# permissions) on /login to click through roles without a GitHub App. Ignored unless ALL hold:
# COVERSET_ENV=dev, open mode (no COVERSET_ADMIN_TOKEN), a loopback COVERSET_BIND, no public
# COVERSET_PUBLIC_URL, and the fake forge with no GitHub credentials (no COVERSET_GITHUB_APP_ID,
# COVERSET_GITHUB_TOKEN or App client secret). Its sessions end once any of them fails. docs/dev.md
COVERSET_DEV_LOGIN=false
# DEBUG also shows Alembic's own log lines when the database is migrated (read from the process
# environment only, not from this file)
# COVERSET_LOG_LEVEL=DEBUG
